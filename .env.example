# OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key-here

# Gemini API (free tier works) for the llm_gemini arm; get a key at https://aistudio.google.com/apikey
# Put the real key in a local ".env" (git-ignored), never in this file or in a commit.
# GEMINI_API_KEY=your-gemini-api-key-here
# QREPAIR_GEMINI_MODEL=<model id shown in AI Studio, e.g. a current Flash model>
# QREPAIR_LLM_MIN_INTERVAL=4      # seconds between calls, to stay inside free-tier per-minute limits

# Optional: IBM Quantum Experience Token for live hardware execution
# IBM_QUANTUM_TOKEN=your-ibm-quantum-token-here
